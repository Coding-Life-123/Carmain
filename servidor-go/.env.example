# Puerto del servidor
PORT=8080

# API key de Anthropic (Claude) para investigar planes de mantenimiento
ANTHROPIC_API_KEY=

# URL de la API de web search (Tavily o Serper)
WEB_SEARCH_API_KEY=

# PostgreSQL para cache de planes (opcional, usa memoria si no está)
DATABASE_URL=postgres://user:pass@localhost:5432/carmain?sslmode=disable
