# Puerto del servidor
PORT=8080

# API key de Google Gemini para la investigación de planes y la búsqueda
# web de motorizaciones (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini (opcional, default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL para cache de planes (opcional, usa memoria si no está)
DATABASE_URL=postgres://user:pass@localhost:5432/carmain?sslmode=disable
